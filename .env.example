DATABASE_URL=postgresql://user:password@host:5432/dbname
PORT=5000
FLASK_ENV=production
API_KEY=your-secret-api-key-here

# Embeddings RAG — SEMPRE OpenAI real (1536 dims fixos no DB, Gemini key não funciona)
EMBEDDINGS_API_KEY=sk-...
# LLM calls (opcional) — pode ser Gemini compat layer ou OpenAI
# Se vazio, usa OPENAI_API_KEY. NÃO afeta embeddings.
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=
EMBEDDING_MODEL=text-embedding-3-small
RAG_MATCH_THRESHOLD=0.7
RAG_MATCH_COUNT=5

# Cache L2 distribuído — Upstash Redis (REST). Vazio = desativado (no-op, fail-open).
# Uma DB free serve STG+PRD via prefixo de chave.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
CACHE_ENV_PREFIX=          # stg | prd (isola chaves na DB compartilhada)
REDIS_TTL_USER=600         # contexto usuário (curto; Postgres é lei)
REDIS_TTL_RAG=3600         # resultado busca vetorial (corta custo embeddings)
REDIS_TTL_MEMORIA=43200    # janela quente chat_memory (12h)
DEDUP_TTL=60               # janela de deduplicação de mensagem
RATE_LIMIT_MAX=30          # requests por janela
RATE_LIMIT_WINDOW=60       # janela do rate-limit (segundos)

# Cache TTLs (segundos)
CACHE_TTL_USUARIO=60
CACHE_TTL_SALDO=300
CACHE_TTL_COMPROVANTES=300
CACHE_TTL_AGENDAMENTOS=120
CACHE_TTL_LISTAS=300
CACHE_TTL_PERSONA=3600
CACHE_TTL_MEMORIA=60
